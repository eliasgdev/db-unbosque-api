# Configuración de la aplicación
APP_NAME="API Sistema Contable - Universidad El Bosque"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# IP del proxy inverso autorizado a enviar X-Forwarded-For (en producción, la IP privada de VM-Front)
FORWARDED_ALLOW_IPS=127.0.0.1
CORS_ORIGINS=http://localhost:4200,http://localhost:5173

# Configuración de PostgreSQL (VM-DB)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=contabilidad_db
DB_USER=contabilidad_user
DB_PASSWORD=cambiar_esta_clave_en_entorno_real
DB_SSLMODE=prefer
DB_POOL_MIN=1
DB_POOL_MAX=10
